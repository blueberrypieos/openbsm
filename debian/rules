#!/usr/bin/make -f
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 The Blueberry Pie OS Authors

include /usr/share/pietoolchain/rules.mk

BSM     := $(SRCROOT)/openbsm/bsm
SOURCES := $(addprefix openbsm/libbsm/,bsm_audit.c bsm_class.c bsm_control.c bsm_domain.c \
	bsm_event.c bsm_flags.c bsm_io.c bsm_mask.c bsm_notify.c bsm_socket_type.c bsm_token.c \
	bsm_user.c bsm_wrappers.c bsm_errno.c bsm_fcntl.c)
OBJS    := $(patsubst %.c,$(OBJ)/%.o,$(SOURCES))
DYLIB   := $(OBJ)/libbsm.0.dylib
FLAGS   := $(BASE_CFLAGS) -I$(SRCROOT)/openbsm -isystem $(SDK)/usr/local/include

$(OBJ)/%.o: $(SRCROOT)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(FLAGS) -c $< -o $@

$(DYLIB): $(OBJS)
	$(CC) $(BASE_LDFLAGS) -dynamiclib -install_name /usr/lib/libbsm.0.dylib \
		-compatibility_version 1 -current_version 1 $(OBJS) -o $@

install: $(DYLIB)
	install -d $(ROOT)/usr/lib $(ROOT)/usr/include/bsm
	install -m 755 $(DYLIB) $(ROOT)/usr/lib/
	ln -sf libbsm.0.dylib $(ROOT)/usr/lib/libbsm.dylib
	install -m 644 $(filter-out $(BSM)/audit.h $(BSM)/audit_record.h $(BSM)/audit_kevents.h $(BSM)/audit_internal.h,$(wildcard $(BSM)/*.h)) $(ROOT)/usr/include/bsm/
	install -d $(ROOT)/usr/share/man/man1
	install -m 644 $(SRCROOT)/openbsm/bin/auditreduce/auditreduce.1 $(SRCROOT)/openbsm/bin/praudit/praudit.1 $(ROOT)/usr/share/man/man1/
	install -d $(ROOT)/usr/share/man/man3
	install -m 644 $(SRCROOT)/openbsm/libbsm/au_class.3 $(SRCROOT)/openbsm/libbsm/au_control.3 $(SRCROOT)/openbsm/libbsm/au_domain.3 $(SRCROOT)/openbsm/libbsm/au_errno.3 $(SRCROOT)/openbsm/libbsm/au_event.3 $(SRCROOT)/openbsm/libbsm/au_fcntl_cmd.3 $(SRCROOT)/openbsm/libbsm/au_free_token.3 $(SRCROOT)/openbsm/libbsm/au_io.3 $(SRCROOT)/openbsm/libbsm/au_mask.3 $(SRCROOT)/openbsm/libbsm/au_open.3 $(SRCROOT)/openbsm/libbsm/au_socket_type.3 $(SRCROOT)/openbsm/libbsm/au_token.3 $(SRCROOT)/openbsm/libbsm/au_user.3 $(SRCROOT)/openbsm/libbsm/audit_submit.3 $(SRCROOT)/openbsm/libbsm/libbsm.3 $(ROOT)/usr/share/man/man3/
	install -d $(ROOT)/usr/share/man/man5
	install -m 644 $(SRCROOT)/openbsm/man/audit.log.5 $(SRCROOT)/openbsm/man/audit_class.5 $(SRCROOT)/openbsm/man/audit_control.5 $(SRCROOT)/openbsm/man/audit_event.5 $(SRCROOT)/openbsm/man/audit_user.5 $(SRCROOT)/openbsm/man/audit_warn.5 $(ROOT)/usr/share/man/man5/
	install -d $(ROOT)/usr/share/man/man8
	install -m 644 $(SRCROOT)/openbsm/bin/audit/audit.8 $(SRCROOT)/openbsm/bin/auditd/auditd.8 $(ROOT)/usr/share/man/man8/

.PHONY: install
